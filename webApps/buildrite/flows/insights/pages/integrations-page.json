{
  "description": "Integrations: every system your workspace's app talks to and every call it makes, read from its code — between systems (the app ⇄ each system by business object, interfaces, cross-system flows), the integration data sheet (source → target), the endpoints, the systems, the diagrams (landscape, a system, a page), exported as a PDF or an Excel workbook (desktop/lib/integrations.js, /__pages/integrations).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "m": {
      "type": "any",
      "defaultValue": null,
      "description": "The scan: { app, apps, totals, systems, rows, endpoints, flows, matrix, pages, unresolved, at, by }."
    },
    "busy": {
      "type": "boolean",
      "defaultValue": false
    },
    "result": {
      "type": "any",
      "defaultValue": null
    },
    "tab": {
      "type": "string",
      "defaultValue": "overview",
      "description": "overview | flows | sheet | endpoints | systems | diagrams"
    },
    "q": {
      "type": "string",
      "defaultValue": ""
    },
    "fSystem": {
      "type": "string",
      "defaultValue": ""
    },
    "fFlow": {
      "type": "string",
      "defaultValue": ""
    },
    "fDir": {
      "type": "string",
      "defaultValue": "all",
      "description": "all | Read | Write | Report"
    },
    "fObject": {
      "type": "string",
      "defaultValue": "",
      "description": "The data sheet shows one business object (an interface's objectKey) — from \"Its rows\" on an interface."
    },
    "fObjectLabel": {
      "type": "string",
      "defaultValue": ""
    },
    "limit": {
      "type": "number",
      "defaultValue": 200,
      "description": "How many data-sheet rows are shown (More shows the next ones)."
    },
    "sq": {
      "type": "string",
      "defaultValue": "",
      "description": "System flows: find an interface or a cross-system flow."
    },
    "sSystem": {
      "type": "string",
      "defaultValue": ""
    },
    "dia": {
      "type": "string",
      "defaultValue": "landscape",
      "description": "landscape | systems | journeys | system | page"
    },
    "diaSystem": {
      "type": "string",
      "defaultValue": ""
    },
    "diaPage": {
      "type": "string",
      "defaultValue": ""
    },
    "pdfBusy": {
      "type": "boolean",
      "defaultValue": false
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "intChain",
          "parameters": {
            "act": "load",
            "key": "",
            "value": ""
          }
        }
      ]
    },
    "onAct": {
      "chains": [
        {
          "chain": "intChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "key": "{{ $event.currentTarget.dataset.key || '' }}",
            "value": ""
          }
        }
      ]
    },
    "onField": {
      "chains": [
        {
          "chain": "intChain",
          "parameters": {
            "act": "field",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.value }}"
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      }
    }
  }
}
