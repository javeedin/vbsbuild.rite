{
  "description": "API Scenarios: a page's REST calls and BI Publisher reports in order, run purely through the APIs with the app's login — a value one call answers feeding the next, each answer checked (status, rows, time, shape, fields), data rows, writes only when allowed and never on production, every run kept on this PC (desktop/lib/apiScenarios.js, /__api/scenarios*).",
  "navigation": {
    "embeddable": "enabled"
  },
  "variables": {
    "pages": {
      "type": "any[]",
      "defaultValue": [],
      "description": "The workspace app's pages (the Application pages catalog)."
    },
    "page": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "The page the open scenario tests (its id: app/flow/page). In the list: the page its scenarios are shown for (a page's own tab, or Application pages → API). A new scenario's tab is given it."
    },
    "facts": {
      "type": "any",
      "defaultValue": null,
      "description": "The page's facts (its technical sheet): its calls, chains, reports."
    },
    "scenarios": {
      "type": "any[]",
      "defaultValue": []
    },
    "sc": {
      "type": "any",
      "defaultValue": null,
      "description": "The scenario open (a copy being edited)."
    },
    "addCall": {
      "type": "string",
      "defaultValue": ""
    },
    "run": {
      "type": "any",
      "defaultValue": null,
      "description": "The run shown."
    },
    "runs": {
      "type": "any[]",
      "defaultValue": []
    },
    "busy": {
      "type": "boolean",
      "defaultValue": false
    },
    "result": {
      "type": "any",
      "defaultValue": null
    },
    "tries": {
      "type": "any",
      "defaultValue": {},
      "description": "Each step run on its own (▶ Run): its result, by step id."
    },
    "trying": {
      "type": "string",
      "defaultValue": "",
      "description": "The step being run on its own."
    },
    "appAt": {
      "type": "any",
      "defaultValue": null,
      "description": "The page your app's window is on: { open, url, page, label } (/__api/scenarios/where)."
    },
    "nextPages": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Where the journey's last page goes next in the app: [{ id, label, via }]."
    },
    "apis": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every API of the page: [{ key, step, role, order, chains, actions, field, when }]."
    },
    "apiChoices": {
      "type": "any[]",
      "defaultValue": []
    },
    "apiQ": {
      "type": "string",
      "defaultValue": ""
    },
    "apiOpen": {
      "type": "string",
      "defaultValue": ""
    },
    "apiTries": {
      "type": "any",
      "defaultValue": {}
    },
    "apiVals": {
      "type": "any",
      "defaultValue": {}
    },
    "suggestion": {
      "type": "any",
      "defaultValue": null,
      "description": "The order suggested for the scenario's steps, and what they miss."
    },
    "journeyApis": {
      "type": "any",
      "defaultValue": null,
      "description": "The APIs dialog of a page of the journey: { page, label, idx, loading, error, apis }."
    },
    "apiInfo": {
      "type": "any",
      "defaultValue": null,
      "description": "The page's counts (as Application pages shows them) and the pages with the same title."
    },
    "flow": {
      "type": "any",
      "defaultValue": null,
      "description": "The page's flow: every page it leads to, how far each is tested (/__api/scenarios/flow)."
    },
    "flowOpen": {
      "type": "boolean",
      "defaultValue": true,
      "description": "The flow card unfolded (kept on this PC)."
    },
    "scId": {
      "type": "string",
      "defaultValue": "",
      "input": "fromCaller",
      "description": "The scenario this tab shows (its id; 'new-…' for one being made). Empty: the list of every scenario."
    },
    "scTab": {
      "type": "string",
      "defaultValue": "main",
      "description": "The scenario's tab: 'main' (its page's APIs), 'flow' (the pages it leads to), 'runs'."
    },
    "allSc": {
      "type": "any[]",
      "defaultValue": [],
      "description": "Every scenario, with its last run (the list)."
    },
    "listQ": {
      "type": "string",
      "defaultValue": "",
      "description": "The list's search: ID, name or page."
    },
    "listStatus": {
      "type": "string",
      "defaultValue": "all",
      "description": "The list's status filter: all, passed, failed, notrun, draft."
    },
    "listPage": {
      "type": "string",
      "defaultValue": "",
      "description": "The list shown for one page only (its id), or every page."
    },
    "flowForce": {
      "type": "boolean",
      "defaultValue": false,
      "description": "Continue to the flow before every API of the main page has run (Continue anyway)."
    },
    "report": {
      "type": "any",
      "defaultValue": null,
      "description": "The test results report of the run shown: { tab: pdf | excel, sheet, answers, busy }."
    },
    "showApis": {
      "type": "boolean",
      "defaultValue": false,
      "description": "The main page's APIs shown under the toolbar (Add from the page's APIs)."
    }
  },
  "events": {
    "focusRequest": {
      "description": "Another screen handed this one a page (shellBus.focus('api-scenarios', { page }))",
      "payloadType": "object"
    },
    "appWhere": {
      "description": "You came back from your app's window: where is it now?",
      "payloadType": "object"
    },
    "scChanged": {
      "description": "A scenario was saved, run or deleted in another tab: the list reads them again (shellBus topic api-scenarios-changed).",
      "payloadType": "object"
    }
  },
  "eventListeners": {
    "vbEnter": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "load",
            "key": "",
            "value": "",
            "step": ""
          }
        }
      ]
    },
    "focusRequest": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "focus",
            "key": "",
            "value": "",
            "step": ""
          }
        }
      ]
    },
    "onAct": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "key": "{{ $event.currentTarget.dataset.key || '' }}",
            "value": "",
            "step": ""
          }
        }
      ]
    },
    "onField": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "field",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.value }}",
            "step": ""
          }
        }
      ]
    },
    "onStep": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "stepField",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.value }}",
            "step": "{{ $event.currentTarget.dataset.step }}"
          }
        }
      ]
    },
    "onTaField": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.detail.updatedFrom === 'internal' ? 'field' : 'none' }}",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.detail.value || '' }}",
            "step": ""
          }
        }
      ]
    },
    "onTaStep": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.detail.updatedFrom === 'internal' ? 'stepField' : 'none' }}",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.detail.value || '' }}",
            "step": "{{ $event.currentTarget.dataset.step }}"
          }
        }
      ]
    },
    "onPickSel": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.detail.updatedFrom === 'internal' ? 'pick' : 'none' }}",
            "key": "{{ $event.currentTarget.dataset.key }}",
            "value": "{{ $event.detail.value == null ? '' : String($event.detail.value) }}",
            "step": ""
          }
        }
      ]
    },
    "appWhere": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "where",
            "key": "",
            "value": "",
            "step": ""
          }
        }
      ]
    },
    "onChoice": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "choice",
            "key": "{{ $event.currentTarget.dataset.key }}",
            "value": "{{ $event.currentTarget.dataset.value }}",
            "step": ""
          }
        }
      ]
    },
    "onApiVals": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.detail.updatedFrom === 'internal' ? 'apiVals' : 'none' }}",
            "key": "{{ $event.currentTarget.dataset.key }}",
            "value": "{{ $event.detail.value || '' }}",
            "step": ""
          }
        }
      ]
    },
    "scChanged": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "list",
            "key": "",
            "value": "",
            "step": ""
          }
        }
      ]
    },
    "onListField": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "listField",
            "key": "{{ $event.currentTarget.dataset.field }}",
            "value": "{{ $event.currentTarget.value }}",
            "step": ""
          }
        }
      ]
    },
    "onSel": {
      "chains": [
        {
          "chain": "scChain",
          "parameters": {
            "act": "{{ $event.currentTarget.dataset.act }}",
            "key": "{{ $event.currentTarget.value }}",
            "value": "",
            "step": ""
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-bind-for-each": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-if": {
        "path": "ojs/ojknockout"
      },
      "oj-bind-text": {
        "path": "ojs/ojknockout"
      },
      "oj-text-area": {
        "path": "ojs/ojinputtext"
      },
      "oj-select-single": {
        "path": "ojs/ojselectsingle"
      }
    }
  }
}
